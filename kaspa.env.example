# Copy to kaspa.env (gitignored). Never commit kaspa.env.

# Mainnet donation wallet (real KAS). Independent crate author — not Kaspa Dev Fund.
# Public address is safe to share. Never commit the private key.
KASPA_DONATION_PRIVATE_KEY=
KASPA_DONATION_ADDRESS=kaspa:qpxdemlyx445kt5xteux0qhadaw8lh5m0vnqvcy8fh483t70usgkkeulsx9cm

# TN10 testnet funding key for examples/silverscript/counter.py (alice)
KASPA_TN10_FUNDING_KEY=
KASPA_FUNDING_KEY=

# Named TN10 test wallets used by examples/tn10_transfer.py.
# alice should match KASPA_TN10_FUNDING_KEY (ensure_wallets() syncs them).
# Empty alice? Fund kaspatest: via https://faucet-tn10.kaspanet.io/ (hCaptcha).
# Internal --topup needs donor >= ~0.45 tKAS (KIP-0009 storage-mass 0.2 tKAS outputs).
KASPA_TN10_WALLET_ALICE_KEY=
KASPA_TN10_WALLET_BOB_KEY=
KASPA_TN10_WALLET_CAROL_KEY=
KASPA_TN10_WALLET_DAVE_KEY=
KASPA_TN10_WALLET_EVE_KEY=
KASPA_TN10_WALLET_FRANK_KEY=
KASPA_TN10_WALLET_GRACE_KEY=

# Optional. Empty = public Resolver.
KASPA_RPC_URL=

# TN10 testnet only. Interim computeBudget to_dict shim until kaspa-python-sdk#78 publishes.
# Set to 1 to enable scripts/tn10_dev_broadcast.ps1. Not for production.
# TN10_SDK_DEV_PATCH=1

# Igra Galleon L2 (chain 38836). iKAS is claimed from faucet.igralabs.com, not minted here.
GALLEON_PRIVATE_KEY=
GALLEON_ADDRESS=
# Published after broadcast. Safe to share. Not a key.
GALLEON_GTEST=0xbc5e27ab3ce2edb243593cda2437e5b30e0d5d7d
GALLEON_MINI_POOL=
GALLEON_FEE_POOL=
# DEX: uses GALLEON_FEE_POOL if set, else GALLEON_MINI_POOL (python examples/galleon_dex.py status)
GALLEON_BRIDGE_FACTORY=
GALLEON_COIN_FLIP=
GALLEON_DICE=
GALLEON_JACKPOT=
# L2 wiKAS release for TN10 HTLC demo (examples/l1_l2_bridge_deploy.py --broadcast)
GALLEON_HTLC_BRIDGE=
# Extra faucet wallets (optional). Each can claim 0.1 iKAS/day, then sweep to primary.
#   python examples/galleon_faucet.py --ensure-extra-range 22 22
#   python examples/galleon_faucet.py --drip-extra 22    # new IP if connection-capped
#   python examples/galleon_faucet.py --sweep --start 22
# If drip skips but wallet has 0 iKAS, remove a stale line from .local/galleon_faucet_claims.txt
GALLEON_PRIVATE_KEY_2=
GALLEON_ADDRESS_2=
